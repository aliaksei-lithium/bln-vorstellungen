# Copy to apps/worker/.dev.vars for local development. Real values go in via `wrangler secret put`.
ADMIN_TOKEN=change-me                  # owner gate for the admin API (scripts, CI)
PUBLIC_ORIGIN=http://localhost:8787    # OAuth issuer for MCP; `wrangler dev` serves here
# The Anthropic key is not a Worker secret: it is stored on the AI Gateway (Provider Keys, alias "default").
