{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bln-vorstellungen",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: OAuth client metadata documents are fetched from client-supplied URLs.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Workers Caching: GET responses are cached per their Cache-Control (public API: 5 min; everything else under
  // /api is no-store). Keyed by Worker version, so a deploy starts with a fresh cache.
  "cache": { "enabled": true },

  // The SPA build. The Worker runs first only for API, MCP and auth routes.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
      "/spotify/*",
      "/youtube/*",
    ],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bln-vorstellungen",
      "database_id": "efa94f54-6bc6-4592-bf88-df8b7884c7bb",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bln-vorstellungen-media" }],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "2ce0a82133f54d078f430e0b7d44fc2b" },
    // MCP OAuth clients, grants and tokens (@cloudflare/workers-oauth-provider); hashes only, props encrypted.
    { "binding": "OAUTH_KV", "id": "7568dad0930d43a189f0e768ae31bb49" },
  ],
  "ai": { "binding": "AI", "remote": true },
  // Event images: one shrink per event into R2 (services/images.ts); 5,000 unique transformations a month free.
  "images": { "binding": "IMAGES" },

  "workflows": [
    { "name": "source-run", "binding": "SOURCE_RUN", "class_name": "SourceRunWorkflow" },
    { "name": "extract-item", "binding": "EXTRACT_ITEM", "class_name": "ExtractItemWorkflow" },
    { "name": "enrich-event", "binding": "ENRICH_EVENT", "class_name": "EnrichEventWorkflow" },
    { "name": "score-events", "binding": "SCORE_EVENTS", "class_name": "ScoreEventsWorkflow" },
    { "name": "photo-ingest", "binding": "PHOTO_INGEST", "class_name": "PhotoIngestWorkflow" },
    { "name": "daily-review", "binding": "DAILY_REVIEW", "class_name": "DailyReviewWorkflow" },
  ],

  // The MCP server is stateless (docs/09, 2026-11-01); its Durable Object is gone.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["McpAgent"] },
    { "tag": "v2", "deleted_classes": ["McpAgent"] },
  ],

  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    "APP_ENV": "production",
    // The site's public origin: OAuth issuer, and `<origin>/mcp` is the MCP resource tokens are bound to.
    "PUBLIC_ORIGIN": "https://bln-vorstellungen.aliaksei-zhynhiarouski.workers.dev",
    // Extraction model: "workers-ai" (free) or a Claude id such as "anthropic/claude-haiku-5.5". Claude needs an
    // Anthropic key stored on the `default` AI Gateway (Provider Keys, alias "default"); without it, it falls back.
    // Claude since 2026-11-01: 3.6x faster and keeps per-date notes (room, premiere) at ~$0.003 per chunk.
    "EXTRACT_MODEL": "anthropic/claude-haiku-5.5",
    // Model for the per-user scoring stage (same choices as EXTRACT_MODEL).
    "SCORE_MODEL": "anthropic/claude-haiku-5.5",
    "CLAUDE_DAILY_USD": "0.5",
  },
}
