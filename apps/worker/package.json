{
  "name": "@bln/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/dev.sql"
  },
  "dependencies": {
    "@bln/shared": "workspace:*",
    "@bln/sources": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  }
}
